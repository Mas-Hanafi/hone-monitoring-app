# Salin ke .env.local lalu isi. Pakai publishable/anon key, JANGAN service role key.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-key>
# Kunci publik VAPID untuk notifikasi HP (hasil `npx web-push generate-vapid-keys`). Kunci PRIVAT hanya di secret Supabase.
VITE_VAPID_PUBLIC_KEY=<kunci-publik-vapid>
